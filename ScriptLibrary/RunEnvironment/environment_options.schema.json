{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External execution environment option catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "options"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "allow_override": {"type": "boolean", "default": false},
    "options": {
      "type": "object",
      "properties": {
        "source": {"$ref": "#/$defs/category"},
        "destination": {"$ref": "#/$defs/category"},
        "model": {"$ref": "#/$defs/category"},
        "target": {"$ref": "#/$defs/category"},
        "case": {"$ref": "#/$defs/category"},
        "execution": {"$ref": "#/$defs/category"},
        "scheduler": {"$ref": "#/$defs/category"},
        "archive": {"$ref": "#/$defs/category"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["values"],
        "properties": {
          "label": {"type": "string"},
          "description": {"type": "string"},
          "values": {"type": "object"},
          "requires": {"type": "object"}
        }
      }
    }
  }
}
