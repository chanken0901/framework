{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External solver execution environment design",
  "type": "object",
  "allOf": [
    {"anyOf": [{"required": ["source"]}, {"required": ["select"], "properties": {"select": {"required": ["source"]}}}]},
    {"anyOf": [{"required": ["destination"]}, {"required": ["select"], "properties": {"select": {"required": ["destination"]}}}]},
    {"anyOf": [{"required": ["model"]}, {"required": ["select"], "properties": {"select": {"required": ["model"]}}}]},
    {"anyOf": [{"required": ["target"]}, {"required": ["select"], "properties": {"select": {"required": ["target"]}}}]},
    {"anyOf": [{"required": ["case"]}, {"required": ["select"], "properties": {"select": {"required": ["case"]}}}]},
    {"anyOf": [{"required": ["execution"]}, {"required": ["select"], "properties": {"select": {"required": ["execution"]}}}]}
  ],
  "required": [
    "schema_version",
    "environment_id",
    "parallel"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "environment_id": {"type": "string", "minLength": 1},
    "option_catalogs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "select": {
      "type": "object",
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "case": {"type": "string", "minLength": 1},
        "execution": {"type": "string", "minLength": 1},
        "scheduler": {"type": "string", "minLength": 1},
        "archive": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "framework_root": {"type": "string", "minLength": 1},
        "model_catalog": {"type": "string"}
      }
    },
    "destination": {
      "type": "object",
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "case_index": {"type": "string", "minLength": 1},
        "auto_case_number": {"type": "boolean"},
        "case_number_width": {"type": "integer", "minimum": 1},
        "case_number_start": {"type": "integer", "minimum": 1}
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1, "deprecated": true},
        "include_tests": {"type": "boolean", "deprecated": true}
      }
    },
    "solver": {
      "type": "object",
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "include_tests": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "machine_profile": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "template": {"type": "string"},
        "extension_templates": {
          "type": "object",
          "propertyNames": {
            "enum": ["multicomponent", "thermodynamics", "transport", "chemistry"]
          },
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "source": {"type": "string"},
        "id": {"type": ["string", "null"]},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "project_name": {"type": "string"},
        "data_root": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "properties": {
          "configuration": {"enum": ["Debug", "Release", "RelWithDebInfo"]},
        "parallel_jobs": {"type": "integer", "minimum": 1}
      }
    },
    "parallel": {
      "type": "object",
      "required": ["use_mpi", "use_openmp", "use_cuda"],
      "properties": {
        "use_mpi": {"type": "boolean"},
        "use_openmp": {"type": "boolean"},
        "use_cuda": {"type": "boolean"},
        "fft_decomposition": {"enum": ["slab", "pencil"]}
      },
      "additionalProperties": false
    },
    "scheduler": {"type": "object"},
    "archive": {"type": "object"}
  }
}
