&simulation
  equation = "GPE"
  case_name = "cufftmp_scaling_256"
  initial_condition = "quantum_taylor_green"
  nx = 256
  ny = 256
  nz = 256
  x_min = 0.0
  x_max = 6.283185307179586
  y_min = 0.0
  y_max = 6.283185307179586
  z_min = 0.0
  z_max = 6.283185307179586
  dt = 1.0e-4
  nsteps = 20
  output_frequency = 0
  write_initial = .false.
  write_meta = .false.
  timing_enabled = .true.
  use_mpi = .true.
  use_cuda = .true.
/

&gpe
  use_dimensionless_parameters = .true.
  alpha = 0.1
  beta = 20.0
  norm = 1.0
  imaginary_time = .false.
  tg_velocity_amplitude = 1.0
  tg_auto_winding = .true.
  argle_enabled = .false.
/
