&simulation
  equation = "GPE"
  case_name = "mpi_smoke"
  initial_condition = "gaussian"
  nx = 4
  ny = 4
  nz = 4
  x_min = -2.0
  x_max = 2.0
  y_min = -2.0
  y_max = 2.0
  z_min = -2.0
  z_max = 2.0
  dt = 1.0e-3
  nsteps = 1
  output_frequency = 1
  output_dir = "tests/mpi_smoke_output"
  write_initial = .true.
  write_meta = .true.
/

&gpe
  g = 1.0
  sigma0 = 1.0
  wx = 1.0
  wy = 1.0
  wz = 1.0
  hbar = 1.0
  mass = 1.0
  norm = 1.0
  imaginary_time = .true.
/
