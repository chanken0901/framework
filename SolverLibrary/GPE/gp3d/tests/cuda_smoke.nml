&simulation
  equation = "GPE"
  case_name = "cuda_smoke"
  initial_condition = "quantum_taylor_green"
  nx = 16
  ny = 16
  nz = 16
  x_min = 0.0
  x_max = 6.283185307179586
  y_min = 0.0
  y_max = 6.283185307179586
  z_min = 0.0
  z_max = 6.283185307179586
  dt = 1.0e-4
  nsteps = 2
  output_frequency = 0
  write_initial = .false.
  write_meta = .false.
  timing_enabled = .true.
  use_cuda = .true.
  cuda_device = 0
/

&gpe
  use_dimensionless_parameters = .true.
  alpha = 0.1
  beta = 20.0
  norm = 1.0
  imaginary_time = .false.
  tg_velocity_amplitude = 1.0
  tg_auto_winding = .true.
  argle_enabled = .true.
  argle_write_seed = .false.
  argle_steps = 2
  argle_output_every = 1
  argle_dtau = 1.0e-4
  argle_tolerance = 0.0
/
